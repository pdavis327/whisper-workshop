# ModelCar for openai/whisper-large-v3.
# Build context is scratch/model-build/ (see docs/03-building-the-modelcar.md).
# KServe mounts the image contents so vLLM sees weights at /models.

FROM registry.access.redhat.com/ubi9/ubi-micro:latest

COPY models /models

RUN chmod -R a+rX /models

USER 65534
